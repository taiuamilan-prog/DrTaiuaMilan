# =====================================================================
# Variáveis de ambiente — App pós-operatório Dr. Taiuã Milan
# =====================================================================
# Copie este arquivo para .env.local (desenvolvimento) e configure
# as mesmas variáveis no painel da Netlify (deploy).

# URL do projeto Supabase (https://xxxxx.supabase.co)
VITE_SUPABASE_URL=

# Chave anon (public). NÃO usar service_role no cliente.
VITE_SUPABASE_ANON_KEY=

# Versão atual do termo de consentimento LGPD (incrementar quando mudar texto)
VITE_LGPD_VERSAO=1
